# Copy to .env or export these in your shell. Never commit real keys.
TRACER_PROVIDER=ollama        # ollama (open-weight Gemma, default) or gemini
TRACER_MODEL=gemma4           # run `ollama list` to see what you have pulled
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=               # optional, only for TRACER_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest   # check Google AI Studio for current names
OPENALEX_MAILTO=              # optional, your email for OpenAlex's polite pool
DATAGOVIN_API_KEY=            # optional API key for data.gov.in
CORS_ORIGINS=http://localhost:3000
